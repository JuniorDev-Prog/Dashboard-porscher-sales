/2 -translate-y-1/2 text-[11px] text-[#8a959c]\" data-kid=\"1-1-2-1-1-3-2-2\" data-name=\"select dropdown chevron icon\"></i>\n</div>\n</div>\n<div data-kid=\"1-1-2-1-1-4\" data-name=\"payment method filter field wrapper\">\n<label class=\"mb-[9px] block text-[12px] font-semibold tracking-[0.01em] text-[#c6d0d6]\" data-kid=\"1-1-2-1-1-4-1\" data-name=\"payment method filter label\" for=\"f-pagamento\">Forma de pagamento</label>\n<div class=\"relative\" data-kid=\"1-1-2-1-1-4-2\" data-name=\"payment method select wrapper\">\n<select class=\"h-[38px] w-full cursor-pointer appearance-none rounded-[6px] border border-[#242d32] bg-[#0d1317] pl-[13px] pr-9 text-[12.5px] text-[#eef3f5] outline-none transition-colors hover:border-[#37424a] focus:border-[#e60c22] focus:ring-2 focus:ring-[#e60c22]/25\" data-kid=\"1-1-2-1-1-4-2-1\" data-name=\"payment method filter select\" id=\"f-pagamento\">\n<option data-kid=\"1-1-2-1-1-4-2-1-1\" data-name=\"payment filter default option\">Todas</option>\n</select>\n<i class=\"ph ph-caret-down pointer-events-none absolute right-[13px] top-1/2 -translate-y-1/2 text-[11px] text-[#8a959c]\" data-kid=\"1-1-2-1-1-4-2-2\" data-name=\"select dropdown chevron icon\"></i>\n</div>\n</div>\n<button class=\"flex h-[38px] items-center justify-center gap-[9px] rounded-[6px] border border-[#ff2a3d] bg-[linear-gradient(180deg,#f11327,#cd0016)] text-[13px] font-semibold tracking-[0.01em] text-white shadow-[0_6px_18px_-6px_rgba(230,12,34,.85)] transition-all hover:brightness-110 hover:shadow-[0_8px_22px_-6px_rgba(230,12,34,.95)] active:translate-y-px\" data-kid=\"1-1-2-1-1-5\" data-name=\"clear filters button\" type=\"button\">\n<i class=\"ph ph-funnel text-[14px]\" data-kid=\"1-1-2-1-1-5-1\" data-name=\"funnel filter icon\"></i>\n            Limpar filtros\n          </button>\n</div>\n</section>\n<!-- ============ KPIs ============ -->\n<section aria-label=\"Indicadores principais\" class=\"mt-4 grid grid-cols-4 gap-[14px]\" data-kid=\"1-1-2-2\" data-name=