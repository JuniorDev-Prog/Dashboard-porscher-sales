gend indicator\">\n<span class=\"h-[7px] w-[7px] rounded-full bg-[#e60c22]\" data-kid=\"1-1-2-3-1-1-2-1\" data-name=\"legend colored dot\"></span>\n<span class=\"text-[11px] text-[#d3dce0]\" data-kid=\"1-1-2-3-1-1-2-2\" data-name=\"legend series label\">Total de Vendas</span>\n</div>\n</div>\n<svg aria-label=\"Evolução das vendas mês a mês em 2023, de 4 em janeiro a 19 em dezembro\" class=\"mt-[6px] w-full\" data-kid=\"1-1-2-3-1-2\" data-name=\"monthly sales line/area chart\" role=\"img\" viewbox=\"0 0 652 168\">\n<defs>\n<lineargradient id=\"areaVendas\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#e60c22\" stop-opacity=\"0.34\"></stop>\n<stop offset=\"0.6\" stop-color=\"#e60c22\" stop-opacity=\"0.09\"></stop>\n<stop offset=\"1\" stop-color=\"#e60c22\" stop-opacity=\"0\"></stop>\n</lineargradient>\n</defs>\n<!-- vertical grid -->\n<g stroke=\"#ffffff\" stroke-opacity=\"0.035\">\n<line x1=\"36\" x2=\"36\" y1=\"16\" y2=\"134\"></line><line x1=\"91.6\" x2=\"91.6\" y1=\"16\" y2=\"134\"></line>\n<line x1=\"147.3\" x2=\"147.3\" y1=\"16\" y2=\"134\"></line><line x1=\"202.9\" x2=\"202.9\" y1=\"16\" y2=\"134\"></line>\n<line x1=\"258.5\" x2=\"258.5\" y1=\"16\" y2=\"134\"></line><line x1=\"314.2\" x2=\"314.2\" y1=\"16\" y2=\"134\"></line>\n<line x1=\"369.8\" x2=\"369.8\" y1=\"16\" y2=\"134\"></line><line x1=\"425.5\" x2=\"425.5\" y1=\"16\" y2=\"134\"></line>\n<line x1=\"481.1\" x2=\"481.1\" y1=\"16\" y2=\"134\"></line><line x1=\"536.7\" x2=\"536.7\" y1=\"16\" y2=\"134\"></line>\n<line x1=\"592.4\" x2=\"592.4\" y1=\"16\" y2=\"134\"></line><line x1=\"648\" x2=\"648\" y1=\"16\" y2=\"134\"></line>\n</g>\n<!-- horizontal grid -->\n<g stroke=\"#ffffff\" stroke-opacity=\"0.045\">\n<line x1=\"36\" x2=\"648\" y1=\"16\" y2=\"16\"></line><line x1=\"36\" x2=\"648\" y1=\"45.5\" y2=\"45.5\"></line>\n<line x1=\"36\" x2=\"648\" y1=\"75\" y2=\"75\"></line><line x1=\"36\" x2=\"648\" y1=\"104.5\" y2=\"104.5\"></line>\n</g>\n<line stroke=\"#2c353b\" x1=\"36\" x2=\"648\" y1=\"134\" y2=\"134\"></line>\n<line stroke=\"#2c353b\" x1=\"36\" x2=\"36\" y1=\"16\" y2=\"134\"></line>\n<!-- area + line -->\n<path d=\"M36,134 L36,110.4 L91.6,83.3 L147.3,96.2 L202.9,72 L258.5,92.7 L314.2,72.6 L369.8,83.3 L425.5,59.7 L481.1,75 L536.7,49 L592.4,63.2 L648,21.9 L648,134 Z\" fill=\"url(#areaVendas)\"></path>\n<polyline fill=\"none\" points=\"36,110.4 91.6,83.3 147.3,96.2 202.9,72 258.5,92.7 314.2,72.6 369.8,83.3 425.5,59.7 481.1,75 536.7,49 592.4,63.2 648,21.9\" stroke=\"#e60c22\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></polyline>\n<!-- points -->\n<g fill=\"#fff\" stroke=\"#e60c22\" stroke-width=\"1.6\">\n<circle cx=\"36\" cy=\"110.4\" r=\"3.2\"></circle><circle cx=\"91.6\" cy=\"83.3\" r=\"3.2\"></circle>\n<circle cx=\"147.3\" cy=\"96.2\" r=\"3.2\"></circle><circle cx=\"202.9\" cy=\"72\" r=\"3.2\"></circle>\n<circle cx=\"258.5\" cy=\"92.7\" r=\"3.2\"></circle><circle cx=\"314.2\" cy=\"72.6\" r=\"3.2\"></circle>\n<circle cx=\"369.8\" cy=\"83.3\" r=\"3.2\"></circle><circle cx=\"425.5\" cy=\"59.7\" r=\"3.2\"></circle>\n<circle cx=\"481.1\" cy=\"75\" r=\"3.2\"></circle><circle cx=\"536.7\" cy=\"49\" r=\"3.2\"></circle>\n<circle cx=\"592.4\" cy=\"63.2\" r=\"3.2\"></circle><circle cx=\"648\" cy=\"21.9\" r=\"3.2\"></circle>\n</g>\n<!-- axis labels -->\n<g class=\"chart-txt\" text-anchor=\"end\">\n<text x=\"26\" y=\"19.5\">20</text><text x=\"26\" y=\"49\">15</text>\n<text x=\"26\" y=\"78.5\">10</text><text x=\"26\" y=\"108\">5</text>\n<text x=\"26\" y=\"137.5\">0</text>\n</g>\n<text class=\"chart-txt\" fill=\"#8b969d\" x=\"0\" y=\"7\">Vendas</text>\n<g class=\"chart-txt-b\" text-anchor=\"middle\">\n<text x=\"36\" y=\"150\">Jan</text><text x=\"91.6\" y=\"150\">Fev</text>\n<text x=\"147.3\" y=\"150\">Mar</text><text x=\"202.9\" y=\"150\">Abr</text>\n<text x=\"258.5\" y=\"150\">Mai</text><text x=\"314.2\" y=\"150\">Jun</text>\n<text x=\"369.8\" y=\"150\">Jul</text><text x=\"425.5\" y=\"150\">Ago</text>\n<text x=\"481.1\" y=\"15